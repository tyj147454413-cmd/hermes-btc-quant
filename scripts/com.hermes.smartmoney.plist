<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  round50 v3 聪明钱账本定时排程 (2026-08-28)
  每小时 :05 结算上一小时市场 + 滚动更新盈利池(赶在 :30 分析前)
  注意: 不用 bash wrapper -- macOS TCC 限制 launchd 执行 Desktop 下 shell 脚本
  (实测 Operation not permitted), 照 com.hermes.bot 模式直接 .venv python 跑。
  安装:
    cp "scripts/com.hermes.smartmoney.plist" ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.hermes.smartmoney.plist
  卸载:
    launchctl unload ~/Library/LaunchAgents/com.hermes.smartmoney.plist
    rm ~/Library/LaunchAgents/com.hermes.smartmoney.plist
  手动触发一次: launchctl start com.hermes.smartmoney
  日志: data/hermes_smart_money_cron.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.smartmoney</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/tangyijun/Desktop/hermes btc/.venv/bin/python</string>
        <string>/Users/tangyijun/Desktop/hermes btc/scripts/smart_money_cron.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/tangyijun/Desktop/hermes btc</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/tangyijun/Desktop/hermes btc/data/hermes_smart_money_cron.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tangyijun/Desktop/hermes btc/data/hermes_smart_money_cron.log</string>
</dict>
</plist>
